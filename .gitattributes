# Normalize to LF in the repository. The team is Windows-primary but the Docker image
# and CI are Linux, and the `mixed-line-ending` pre-commit hook enforces LF — without
# this, git's autocrlf and the hook fight over every file on every commit.
* text=auto eol=lf

# Shell scripts must keep LF even on Windows checkouts (a CRLF shebang breaks them).
*.sh   text eol=lf
Makefile text eol=lf

# PowerShell is happiest with CRLF on Windows.
*.ps1  text eol=crlf

# Never touch these.
*.png  binary
*.jpg  binary
*.pdf  binary
*.pt   binary
*.bin  binary
*.safetensors binary
*.db   binary
